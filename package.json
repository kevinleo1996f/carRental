{
  "name": "carrental",
  "version": "1.0.0",
  "description": "Car rental booking API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "seed": "node src/scripts/seedCars.js",
    "demo:cors:allowed": "python3 -m http.server 3002 --directory public",
    "demo:cors:blocked": "python3 -m http.server 8080 --directory public",
    "test": "DB_NAME=carrental_test jest --runInBand",
    "test:local": "DB_NAME=carrental_test DB_HOST=localhost DB_PORT=5433 jest --runInBand",
    "test:coverage": "DB_NAME=carrental_test jest --runInBand --coverage",
    "test:coverage:local": "DB_NAME=carrental_test DB_HOST=localhost DB_PORT=5433 jest --runInBand --coverage",
    "test:integration": "DB_NAME=carrental_test jest --runInBand tests/integration",
    "test:integration:local": "DB_NAME=carrental_test DB_HOST=localhost DB_PORT=5433 jest --runInBand tests/integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
