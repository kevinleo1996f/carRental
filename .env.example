# Optional. `docker compose up` works with zero setup and no .env at all --
# docker-compose.yml bakes in a safe, local-only default for every one of
# these. Copy this file to .env only if you want to override any of them
# (a real NINJA_API_KEY, your own JWT_SECRET/admin password, etc.) -- .env
# is gitignored, so anything you put here never leaves your machine.

PORT=3000

# Postgres — DB_HOST is overridden to "postgres" automatically inside Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carrental
DB_USER=carrental
DB_PASSWORD=carrental

# RabbitMQ — RABBITMQ_HOST is overridden to "rabbitmq" automatically inside Docker Compose
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Admin login (no admin DB row — see openapi.yaml notes)
ADMIN_EMAIL=admin@carrental.local
ADMIN_PASSWORD=change-this-admin-password

# Ninja API (https://api-ninjas.com/profile)
NINJA_API_KEY=your-ninja-api-key-here

# CORS — the only browser origin allowed to call this API. Requests with
# no Origin header (curl, Postman) are unaffected either way.
CORS_ORIGIN=http://localhost:3002
